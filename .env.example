# Local defaults; copy to .env. Never commit .env or instance/.
APP_ENV=development
FLASK_DEBUG=0
# Leave blank locally: persistent random keys are generated in ignored instance/.
SECRET_KEY=
TOTP_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///autoguard.db
PORT=5050
PUBLIC_BASE_URL=http://127.0.0.1:5050
RATELIMIT_STORAGE_URI=memory://
# Cloudflare's PUBLIC DUMMY keys; server verification still requires Internet.
# Replace BOTH keys for production; dummy keys are rejected there.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAME=
# file: local .eml outbox, no emails sent. smtp: STARTTLS, port 587.
MAIL_MODE=file
MAIL_FROM=autoguard@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
